{
  "name": "cyber-defender",
  "version": "1.0.0",
  "private": true,
  "description": "Cyber Defender — Interactive Cybersecurity Awareness Application",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.14.0",
    "mongoose": "^9.10.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0"
  }
}
